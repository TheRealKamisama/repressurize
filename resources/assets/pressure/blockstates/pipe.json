{
  "multipart": [
    {
      "when": {
        "straight": "none"
      },
      "apply": {
        "model": "pressure:block/pipe_center"
      }
    },
    {
      "when": {
        "straight": "x"
      },
      "apply": {
        "model": "pressure:block/pipe_straight",
        "y": 90,
        "x": 90
      }
    },
    {
      "when": {
        "straight": "y"
      },
      "apply": {
        "model": "pressure:block/pipe_straight"
      }
    },
    {
      "when": {
        "straight": "z"
      },
      "apply": {
        "model": "pressure:block/pipe_straight",
        "x": 90
      }
    },
    {
      "when": {
        "straight": "none",
        "east": "true"
      },
      "apply": {
        "model": "pressure:block/pipe_section",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "straight": "none",
        "west": "true"
      },
      "apply": {
        "model": "pressure:block/pipe_section",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "straight": "none",
        "north": "true"
      },
      "apply": {
        "model": "pressure:block/pipe_section",
        "x": 90
      }
    },
    {
      "when": {
        "straight": "none",
        "south": "true"
      },
      "apply": {
        "model": "pressure:block/pipe_section",
        "x": 270
      }
    },
    {
      "when": {
        "straight": "none",
        "down": "true"
      },
      "apply": {
        "model": "pressure:block/pipe_section",
        "x": 180
      }
    },
    {
      "when": {
        "straight": "none",
        "up": "true"
      },
      "apply": {
        "model": "pressure:block/pipe_section"
      }
    }
  ]
}
